# Vercel and the Render Docker image both serve the API same-origin: Vercel via
# the /api rewrite in vercel.json, Render via Nginx. Committing this keeps the
# production build self-contained, so a missing dashboard variable cannot make
# httpClient.ts throw "VITE_API_BASE_URL must be set" and blank the app.
VITE_API_BASE_URL=/api
